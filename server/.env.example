# Copy to .env and fill in real values on the VPS

# Port the Node app listens on (Caddy proxies to this)
PORT=3000
HOST=127.0.0.1

# Long random string — sign in tokens. Generate one, keep it secret.
# e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Where the JSON database file lives (absolute path recommended on the VPS)
DATA_FILE=C:\tadm\data\db.json

# Folder with the built React site (dist). Node serves it.
STATIC_DIR=C:\tadm\dist

# First-run admin account (only used when the database is empty)
ADMIN_USER=ebraqg1029
ADMIN_PASS=change-this-strong-password
ADMIN_NAME=ابراهيم القحطاني

# Allowed browser origin. "*" is fine when Node serves the site itself.
# If the site stays on Namecheap, set: https://tadm.online
CORS_ORIGIN=*
